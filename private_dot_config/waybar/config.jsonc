{
    "layer": "top",
    "modules-left": ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["cpu","memory","clock"],
    "niri/window": {
        "max-length": 50
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },
    "memory": {
	    "format": "{}% ",
    },
    "cpu": {
        "format": "{}% ",
    }
}
